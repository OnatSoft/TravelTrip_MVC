
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title> Easy Trip Blog - Admin Paneli </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>

    <style>
        .process-btn {
            margin-right: 12px;
        }

        body {
            background-color: #cccccc;
        }
    </style>
</head>
<body>

    <div class="w3-sidebar w3-dark-grey w3-bar-block" style="width:12%;">
        <h5 class="w3-bar-item" style="padding: 28px 16px 28px 16px;"> Hoşgeldin Onat </h5>
        <a href="/admin/BlogList/" class="w3-bar-item w3-button"> Bloglar </a>
        <a href="/admin/CommentList/" class="w3-bar-item w3-button"> Yorumlar </a>
        <a href="/admin/Inbox/" class="w3-bar-item w3-button"> Gelen Kutusu </a>
        <a href="/anasayfa/" target="_blank" class="w3-bar-item w3-button"> Siteye Git </a>
        <a href="/login/Logout" class="w3-bar-item w3-button"> Çıkış Yap </a>

    </div>
    <div style="margin-left:12%;">

        <div class="w3-container w3-teal" style="padding: 12px; margin-bottom: 12px;">
            <h1> Blog Admin Paneli </h1>
        </div>
        <div class="w3-container">
            @RenderBody()
        </div>

    </div>

</body>
</html>