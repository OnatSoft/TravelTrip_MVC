@using TravelTrip_MVCProject.Models.Classes
@using PagedList
@using PagedList.Mvc

@model PagedList.IPagedList<YorumlarTBL>

@{
    ViewBag.Title = "CommentList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
    
<h2> Yorumlar </h2>
<br />

<table class="table table-bordered table-hover table-dark">
    <tr>
        <th> ID </th>
        <th> İsim </th>
        <th> E-posta </th>
        <th> Yorum İçeriği </th>
        <th> Yazılan Blog </th>
        <th> İşlemler </th>
    </tr>

    @foreach (var y in Model)
    {
        <tr>
            <td>@y.ID</td>
            <td>@y.KullaniciAdi</td>
            <td>@y.Email</td>
            <td>@y.Yorum</td>
            <td>@y.Blog.Baslik</td>
            <td>
                <a href="/admin/DeleteComment/@y.ID" class="btn btn-danger process-btn" onclick="return confirm('Bu yorumu kalıcı olarak silmekten emin misiniz?')"> Sil </a>
                <a href="/admin/UpdateComment/@y.ID" class="btn btn-info process-btn"> Güncelle </a>
            </td>
        </tr>
    }
</table>

@Html.PagedListPager((IPagedList)Model, page => Url.Action("CommentList", new { page = page }), new PagedListRenderOptions { LinkToPreviousPageFormat = "< Önceki", LinkToNextPageFormat = "Sonraki >", LiElementClasses = new[] { "page-item" }, UlElementClasses = new[] { "pagination" } })