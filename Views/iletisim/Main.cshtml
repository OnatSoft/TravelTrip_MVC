@model TravelTrip_MVCProject.Models.Classes.iletisimTBL

@{
    ViewBag.Title = "Main";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.5.1.min.js" type="text/javascript"></script>
<script src="~/Scripts/bootstrap.min.js"></script>

<div class="contact">
    <div class="wrap">
        <div class="contact-top">
            <h3> Bizimle İletişim Kurun </h3>
            <p> insitam; est usus legentis in iis qui facit eorum claritatem. Investigationes demonstraverunt lectores legere me lius quod ii legunt saepius. Claritas est etiam processus dynamicus, qui sequitur mutationem consuetudium lectorum. Mirum est notare quam littera gothica, quam nu</p>
        </div>

        <div class="form">
            <form class="form-section" method="post">
                <div class="left-field">
                    @Html.TextBoxFor(x => x.AdSoyad, new { @class = "form-control-plaintext", @placeholder = "*Ad Soyad:", @type = "text", @required = "", @id = "AdSoyad" })
                    @Html.TextBoxFor(x => x.Mail, new { @class = "form-control-plaintext", @placeholder = "*E-posta:", @type = "email", @required = "", @id = "Mail" })
                    @Html.TextBoxFor(x => x.Telefon, new { @class = "form-control-plaintext", @placeholder = "Telefon:", @type = "tel", @id = "Telefon" })

                </div>

                <div class="right-field textarea">
                    @Html.TextAreaFor(x => x.Mesaj, new { @class = "form-control-plaintext", @placeholder = "*Mesajınız:", @type = "text", @required = "", @id = "Mesaj" })
                    <button type="submit" class="btn-submit" id="btn"> Gönder </button>
                    <div id="result"></div>
                </div>
            </form>

            <div class="contact-left">
                <div class="contact-add">
                    <h3> Adres </h3>
                    <p> Çanakkale, Türkiye </p>
                    <p> Telefon: +90 (212) 000 0000 </p>
                    <p> E-posta Adresi: <a href="mailto:onatsoft22@gmail.com">onatsoft22@gmail.com</a></p>
                    <p> Web Site: <a href="https://linktr.ee/onatt2645" target="_blank"> https://linktr.ee/onatt2645 </a></p>
                </div>
            </div>

            <div style="position: relative; overflow: hidden; width: 980px; height: 420px; margin-bottom: 34px;"><a href="https://yandex.com.tr/harita/103873/canakkale/?utm_medium=mapframe&utm_source=maps" style="color:#eee;font-size:12px;position:absolute;top:0px;">Çanakkale</a><a href="https://yandex.com.tr/harita/103873/canakkale/?l=sat%2Cskl&ll=26.413310%2C40.147612&utm_medium=mapframe&utm_source=maps&z=15" style="color:#eee;font-size:12px;position:absolute;top:14px;">Yandex Maps</a><iframe src="https://yandex.com.tr/map-widget/v1/?l=sat%2Cskl&ll=26.413310%2C40.147612&z=15" width="980" height="420" frameborder="1" allowfullscreen="true" style="position:relative;"></iframe></div>
        </div>

    </div>
</div>

<script type="text/javascript">

    $("#btn").click(function (e) {
        let values = {
            AdSoyad: $("#AdSoyad").val(),
            Mail: $("#Mail").val(),
            Telefon: $("#Telefon").val(),
            Mesaj: $("#Mesaj").val()
        };

        var alan = document.createElement("div");
        alan.className = "alert alert-success";
        alan.innerHTML = "Mesajınız başarıyla gönderilmiştir, teşekkürler!";
        document.body.appendChild(alan);
        e.preventDefault();

        $.ajax({
            type: "post",
            url: "/iletisim/Main/",
            data: values,
            success: function (f) {
                $("#result").html(alan);
                setTimeout(() => { window.location.reload() }, 6000);
            }
        });
    });

</script>